{
  "manifest_version": 3,
  "name": "ChatGPT Limit Banner Hider",
  "version": "1.0.0",
  "description": "Hides the workspace limit banner in the ChatGPT web app wrapper.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
